# Screen resolution
# SCREEN_RESOLUTION=1920x1080
# SCREEN_ROTATION=0

# without string quote
SECOND_WINDOW_TITLE=YourTargetWindowTitle

# Window size: WxH or "maximized" (default: 1280x1032)
# SECOND_WINDOW_SIZE=1280x1032

# Window position as x,y (default: 0,0)
# SECOND_WINDOW_POS=0,0

# Cooldown in seconds after killing Telegram before retrying (default: 60)
# KILL_COOLDOWN_SECONDS=60

# Click points as semicolon-separated x,y pairs, measured in 100% scaling pixels
# (the script converts them automatically for your display scaling)
# CLICK_POINTS=44,240;207,119;755,113

# Number of click retry attempts before recovery (default: 3)
# SECOND_WINDOW_RETRY_LIMIT=3

# Seconds between click retry attempts (default: 3.0)
# CLICK_RETRY_INTERVAL=3.0

# Stream recording: off, long-living, or follow-schedule (default: off)
# RECORD_MODE=off

# Stream address to record; empty means recording cannot start
# RECORD_STREAM_URL=

# Clips folder; must be an absolute path. A relative or empty value warns and
# falls back to the default, which is the Recordings folder next to the program.
# For example: RECORDINGS_DIR=D:\Recordings  (or a UNC path such as
# \\server\share\clips). Default: the Recordings folder next to the program.
# RECORDINGS_DIR=D:\Recordings

# Clip length in seconds (default: 7200)
# RECORD_CLIP_SECONDS=7200

# Seconds to wait after the recorder stops before reconnecting (default: 5)
# RECORD_RECONNECT_SECONDS=5

# Recorder program; a bare name is found on the system path (default: ffmpeg)
# RECORD_FFMPEG_PATH=ffmpeg

# Free space, in gigabytes, below which a warning is logged once (default: 10)
# RECORD_DISK_WARN_GB=10

# Free space, in gigabytes, below which recording stops; must be below the
# warning level (default: 2)
# RECORD_DISK_STOP_GB=2

# Log verbosity: DEBUG, INFO, WARNING, or ERROR (default: INFO).
# Set DEBUG to see the recorder's full chatter — every line it writes, plus
# the Stream Check's step-by-step look at the playlist. Anything else warns
# and falls back to INFO.
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# List Recorder (record_streams.py): records every person on the live stream
# list, one Clip per person. It shares RECORDINGS_DIR and LOG_LEVEL with the
# automator and ignores RECORD_MODE and RECORD_STREAM_URL.
# ---------------------------------------------------------------------------

# Stream List address, read again every few seconds
# (default: http://127.0.0.1:8479/)
# STREAMS_URL=http://127.0.0.1:8479/

# Seconds between two readings of the Stream List; fractions allowed
# (default: 5)
# STREAMS_POLL_SECONDS=5

# Clip length in seconds; 15 minutes by default (default: 900)
# STREAMS_CLIP_SECONDS=900

# Seconds to wait after a stream drops before each reconnection attempt
# (default: 5)
# STREAMS_RECONNECT_SECONDS=5

# Reconnection attempts per drop before the person is given up (default: 2)
# STREAMS_RETRY_LIMIT=2

# Seconds a reconnected stream must last to count as a good run and give the
# person their attempts back (default: 120)
# STREAMS_RETRY_RESET_SECONDS=120

# Recorder program; a bare name is found on the system path (default: ffmpeg)
# STREAMS_FFMPEG_PATH=ffmpeg

# Free space, in gigabytes, below which a warning is logged once (default: 10)
# STREAMS_DISK_WARN_GB=10

# Free space, in gigabytes, below which every List Recording stops; must be
# below the warning level (default: 2)
# STREAMS_DISK_STOP_GB=2

